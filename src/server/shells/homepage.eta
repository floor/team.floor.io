<div class="landing">
  <section class="hero" aria-labelledby="hero-title">
    <span class="eyebrow"><%= it.versionLine %></span>
    <h1 class="hero__name" id="hero-title"><%= it.headlineLead %><br><span class="hero__accent"><%= it.headlineAccent %></span></h1>
    <p class="hero__tagline"><%= it.subline %></p>
    <div class="hero__actions"><a class="mtrl-button mtrl-button--filled" href="/docs/">Get started <span class="mtrl-button__icon" aria-hidden="true">→</span></a><a class="mtrl-button mtrl-button--tonal" href="/docs/commands/">Command reference</a></div>
    <div class="hero__install"><%~ it.install %></div>
    <div class="hero__notes"><span>No runtime dependencies</span><span>Node 22 or later</span><span>MIT</span></div>
  </section>
  <div class="landing-points">
    <% it.points.forEach((point, index) => { %><div><span class="feature-index">0<%= index + 1 %></span><h2><%= point.title %></h2><p><%~ point.html %></p></div><% }); %>
  </div>
  <section class="samples" aria-labelledby="samples-title">
    <h2 class="ui-title" id="samples-title">One file, a plan, and a reading</h2>
    <p class="samples__lead">Every block below is a tested page of the command reference, shown as it is there.</p>
    <% it.samples.forEach(sample => { %><div class="sample"><h3 class="sample__label"><%= sample.label %></h3><p class="sample__caption"><%~ sample.caption %></p><%~ sample.html %></div><% }); %>
    <p class="samples__foot">The file and the reading come from the <a href="/docs/commands/status/">team status</a> page, and the plan from the <a href="/docs/commands/down/">team down</a> page, each of which runs it against its own fixture team.</p>
  </section>
  <div class="landing-next">
    <a class="doc-entry" href="/docs/config/"><span class="doc-entry__name">Team configuration</span><span class="doc-entry__summary">The team’s registry record, edited with <code>team config</code>: six sections, then the format and the other fields.</span></a>
    <a class="doc-entry" href="/docs/safety/"><span class="doc-entry__name">Safety</span><span class="doc-entry__summary">The owner, the live record, grants and delegates, and what team never does.</span></a>
    <a class="doc-entry" href="/docs/clis/"><span class="doc-entry__name">Supported CLIs</span><span class="doc-entry__summary">claude-code, codex, cursor and antigravity.</span></a>
  </div>
</div>
