    "brand-images": "bun scripts/brand-images.ts"
  },
  "dependencies": {
    "eta": "4.5.1",
    "highlight.js": "11.11.1",
    "marked": "17.0.2",
    "material": "3.0.1",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "playwright": "1.63.0",
    "typescript": "^5.8.2"
  }
