{
  "name": "team.floor.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "bun scripts/content.ts",
    "dev": "bun scripts/content.ts && bun scripts/dev.ts",
    "start": "bun server.ts",
